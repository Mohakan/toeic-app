{
  "name": "toeic-quest-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "grant": "tsx --env-file-if-exists=.env scripts/grant.ts",
    "sabil:call": "tsx --env-file-if-exists=.env scripts/sabil-call.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
