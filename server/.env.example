# Copy to .env and adjust. Without TOEIC_DATABASE_URL (a generic DATABASE_URL is ignored on purpose),
# the server uses PGlite in PGLITE_DIR (development).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# TOEIC_DATABASE_URL=postgres://toeic:toeic@localhost:5432/toeic
PGLITE_DIR=./.data/pglite
# Without SMTP_URL (development), e-mails are written to the log. Required in production.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Toki Quest <no-reply@tokiquest.app>
# Web origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:8081
# 1 behind a reverse proxy (so rate limits see the client's address).
TRUST_PROXY=0
# Public https address of this server: Konnect webhook and the web payment page. Required in production.
PUBLIC_URL=http://localhost:4000

# --- App Store (lot M4). Root certificates: download AppleRootCA-G3.cer (and AppleIncRootCertificate.cer)
# from https://www.apple.com/certificateauthority/ and list their paths.
# APPLE_BUNDLE_ID=app.tokiquest
# APPLE_APP_ID=1234567890
# APPLE_PRODUCT_ID=toki_quest_full
# APPLE_ROOT_CERTS=./certs/AppleRootCA-G3.cer,./certs/AppleIncRootCertificate.cer
# App Store Connect > App > App Store Server Notifications (Version 2): PUBLIC_URL/webhooks/apple

# --- Google Play (lot M4): a service account with access to the app in Play Console.
# GOOGLE_PACKAGE_NAME=app.tokiquest
# GOOGLE_PRODUCT_ID=toki_quest_full
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/play-service-account.json
# Real-time developer notifications: Pub/Sub push subscription to PUBLIC_URL/webhooks/google,
# with authentication; the audience and the push service account must match these values.
# GOOGLE_PUBSUB_AUDIENCE=https://api.tokiquest.app/webhooks/google
# GOOGLE_PUBSUB_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com

# --- Other apps of the family (Toki Quest B2, Toki Quest Academic). The variables above describe
# the TOEIC app; each other app sells its own full plan, which opens that exam only. The Apple root
# certificates, the Google service account and Pub/Sub settings are shared.
# STORE_APPS=[{"exam":"b2First","appleBundleId":"app.tokiquest.b2","appleAppId":1234567891,"googlePackage":"app.tokiquest.b2","productId":"toki_quest_b2_full"}]

# --- Konnect, web payment in Tunisia (lot M4). Sandbox by default.
# KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# WEB_TN_PRICE_MILLIMES=20000

# --- Sabil partner API (lot M5). Off until both are set; the secret needs 32 characters or more.
# SABIL_API_KEY=
# SABIL_HMAC_SECRET=
