{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.tokiquest.app" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.tokiquest.app" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tokiquest.app" }
    },
    "development-b2": {
      "extends": "development",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.tokiquest.app", "EXPO_PUBLIC_EXAM": "b2First" }
    },
    "preview-b2": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.tokiquest.app", "EXPO_PUBLIC_EXAM": "b2First" }
    },
    "production-b2": {
      "extends": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tokiquest.app", "EXPO_PUBLIC_EXAM": "b2First" }
    }
  },
  "submit": {
    "production": {},
    "production-b2": {}
  }
}
